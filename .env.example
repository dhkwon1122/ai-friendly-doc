# ---- CLI(ai-friendly-doc)용: Confluence Cloud 예시 ----
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_AUTH_TYPE=basic
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your-api-token

# Confluence Server/Data Center를 쓰는 경우 아래 방식 사용
# CONFLUENCE_AUTH_TYPE=bearer
# CONFLUENCE_API_TOKEN=your-personal-access-token

# PAT 발급이 안 되는 Server/Data Center면 계정 ID + 비밀번호로 Basic Auth
# (CONFLUENCE_EMAIL 자리에 이메일이 아닌 계정 ID를 넣어도 된다)
# CONFLUENCE_AUTH_TYPE=userpass
# CONFLUENCE_EMAIL=your-account-id
# CONFLUENCE_API_TOKEN=your-password

# 사내 Confluence가 자체 서명(self-signed) 인증서를 쓰는 등 TLS 검증이 실패하는
# 경우에만 끌 것. 신뢰할 수 있는 사내망 안에서만 사용하고, 공인 인증서를 쓰는
# 서버(Cloud 등)에는 절대 끄지 말 것 - 중간자 공격에 노출될 수 있음.
# CONFLUENCE_VERIFY_SSL=false

# ---- 웹 UI(ai-friendly-doc-web)용 ----
# CONFLUENCE_AUTH_TYPE / CONFLUENCE_EMAIL / CONFLUENCE_API_TOKEN은 CLI 전용이며
# 웹 UI에서는 사용되지 않는다 (각 사용자가 /settings에서 본인 인증 정보를 입력/저장).
#
# 다만 CONFLUENCE_BASE_URL과 CONFLUENCE_VERIFY_SSL은 위에서 설정돼 있으면 웹
# UI에도 그대로 적용된다. CONFLUENCE_BASE_URL이 설정되면 모든 사용자에게
# 고정된 값으로 보이고(/settings에서 수정 불가) 각자 입력할 필요가 없어진다.
# 조직에 Confluence 인스턴스가 하나뿐이면 이렇게 쓰는 걸 권장한다. 사용자마다
# 다른 인스턴스에 접속해야 한다면 이 값을 비워두면(주석 처리) 각자 /settings에서
# 직접 입력하게 된다.

# 저장된 토큰을 암호화하는 키. 아래 명령으로 생성:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# 로그인 세션 쿠키 서명 키. 아래 명령으로 생성:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# 사용자 계정/Confluence 토큰을 저장할 DB.
#
# 로컬 개발(디폴트, 아래 두 줄 다 비워두면 적용): SQLite 파일 사용
# AI_FRIENDLY_DOC_DB=ai_friendly_doc.db
#
# 서버/운영(docker-compose로 띄울 때): 이미 docker로 떠 있는 PostgreSQL을 사용.
# 이 서버는 postgres가 호스트에 포트로 노출되어 있으므로, 컨테이너에서는
# host.docker.internal로 접속한다(docker-compose.yml의 extra_hosts 참고).
# 아래 <...> 부분을 실제 값으로 채우고 주석을 해제할 것.
# DB/유저를 아직 안 만들었다면 scripts/init_postgres.sql 참고.
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@host.docker.internal:5432/<dbname>

# 웹 서버 바인딩 (기본값 127.0.0.1:12345, docker-compose는 0.0.0.0으로 고정되어 있음)
# HOST=0.0.0.0
# PORT=12345

# ---- LLM 심층 검토(선택) ----
# LLM_BASE_URL을 지정하면, 규칙 기반 체크에 더해 실제 문서 내용을 LLM에게
# 읽혀서 "AI가 이 문서만 보고 이해할 수 있는가" 관점의 심층 검토를 자동으로
# 같이 수행한다 (CLI/웹 UI 공통, 켜져 있으면 항상 실행됨 - 별도 옵션 없음).
# 비워두면 지금처럼 규칙 기반 체크만 동작한다.
#
# vLLM 등 OpenAI 호환 API 엔드포인트를 그대로 쓸 수 있다. 이 서버에 vLLM이
# 이미 떠 있다면, postgres와 마찬가지로 host.docker.internal로 접속하면 된다
# (docker-compose.yml의 extra_hosts 참고).
# LLM_BASE_URL=http://host.docker.internal:8000/v1
# LLM_MODEL=served-model-name-in-vllm
# vLLM이 별도 인증을 요구하지 않으면 비워둬도 된다 (내부적으로 더미 값 사용).
# LLM_API_KEY=

# 문서가 너무 길면 앞부분만 잘라서 보낸다 (글자 수 기준, 기본 12000).
# LLM_MAX_INPUT_CHARS=12000
# LLM 응답 대기 시간(초), 기본 60.
# LLM_TIMEOUT_SECONDS=60
# LLM 응답 최대 토큰 수. 지정하지 않으면 문서 길이에 비례해 자동으로
# 정해진다 (최소 4096) - 문서 전체 수정본까지 만들어야 해서 응답이 길기
# 때문. 그래도 응답이 잘리면(리포트에 "최대 토큰 제한으로 잘렸습니다"
# 오류) 여기서 직접 더 큰 값을 지정한다.
# LLM_MAX_OUTPUT_TOKENS=4096

# ---- docker-compose 빌드용 ----
# 사내 PyPI 저장소를 써야 하는 환경이면 지정 (docker-compose.yml이 빌드 시
# 이 값들을 Dockerfile의 --build-arg로 넘긴다). 비워두면 공개 PyPI, trusted-host 없음.
# PIP_INDEX_URL=https://your-internal-pypi.example.com/simple
# PIP_TRUSTED_HOST=your-internal-pypi.example.com

# ---- docker-compose.local-test.yml(로컬 테스트)용 ----
# 테스트 전용 postgres 컨테이너의 유저/비밀번호/DB명. 지정 안 하면
# docker-compose.local-test.yml에 있는 기본값(sait-people / local-test-password /
# people_user_db)을 쓴다. 테스트용이라도 실제 값은 git에 올라가지 않는 이 .env에만
# 적어둘 것. 비밀번호에 ':' '@' '/' 같은 URL 특수문자는 쓰지 말 것.
# LOCAL_TEST_DB_USER=sait-people
# LOCAL_TEST_DB_PASSWORD=local-test-password
# LOCAL_TEST_DB_NAME=people_user_db
