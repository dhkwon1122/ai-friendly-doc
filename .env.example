# ---- CLI(ai-friendly-doc)용: Confluence Cloud 예시 ----
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_AUTH_TYPE=basic
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your-api-token

# Confluence Server/Data Center를 쓰는 경우 아래 방식 사용
# CONFLUENCE_AUTH_TYPE=bearer
# CONFLUENCE_API_TOKEN=your-personal-access-token

# ---- 웹 UI(ai-friendly-doc-web)용 ----
# 각 사용자가 로그인 후 본인의 Confluence 토큰을 화면에서 입력/저장하므로
# 위 CONFLUENCE_* 값은 웹 UI에서는 사용되지 않는다.

# 저장된 토큰을 암호화하는 키. 아래 명령으로 생성:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# 로그인 세션 쿠키 서명 키. 아래 명령으로 생성:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# 사용자 계정/Confluence 토큰을 저장할 DB.
#
# 로컬 개발(디폴트, 아래 두 줄 다 비워두면 적용): SQLite 파일 사용
# AI_FRIENDLY_DOC_DB=ai_friendly_doc.db
#
# 서버/운영(docker-compose로 띄울 때): 이미 docker로 떠 있는 PostgreSQL을 사용.
# 이 서버는 postgres가 호스트에 포트로 노출되어 있으므로, 컨테이너에서는
# host.docker.internal로 접속한다(docker-compose.yml의 extra_hosts 참고).
# 아래 <...> 부분을 실제 값으로 채우고 주석을 해제할 것.
# DB/유저를 아직 안 만들었다면 scripts/init_postgres.sql 참고.
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@host.docker.internal:5432/<dbname>

# 웹 서버 바인딩 (기본값 127.0.0.1:12345, docker-compose는 0.0.0.0으로 고정되어 있음)
# HOST=0.0.0.0
# PORT=12345
